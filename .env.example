# Claude (Anthropic) is the only model provider. ANTHROPIC_API_KEY is accepted too.
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
# Default claude-opus-5-5 (best on handwriting); claude-sonnet-5-5 is about 3x cheaper per form.
CLAUDE_MODEL=
# low | medium | high (default) | xhigh | max - used for extraction, name check and re-read
CLAUDE_EFFORT=
# Handwritten-name crops only: own model / effort (default: the two settings above). claude-fable-5-1 is
# stronger but requires 30-day data retention at Anthropic - a privacy decision for real patient data.
NAME_CHECK_MODEL=
NAME_CHECK_EFFORT=
# Name crops: enlarge small ones and add a view without yellow highlighter. Default true.
NAME_CROP_ENHANCE=
# Correct name suggestions to a known Israeli name by look-alike letters. Default true.
NAME_DICTIONARY=
# Forms with the same valid ID share their names as a suggestion. Default false (samples share one ID).
BATCH_NAME_SHARING=

POPPLER_PATH=

# Zoomed crops of highlighted regions sent with the page. Default true.
HIGHLIGHT_CROPS=
# Development only: save those crops to data/temp/highlight_debug/ (deleted at the next run). Default false.
HIGHLIGHT_DEBUG=

# Extra validation (central prefix, received-date window / collection date, batch ID check). Default true.
STRICT_VALIDATION=
# Expected central-number prefixes, comma separated (a mismatch is a warning flag). Default 93,94.
CENTRAL_NUMBER_PREFIXES=
# Received dates older than this many days are flagged. Default 90.
RECEIVED_DATE_MAX_AGE_DAYS=
# The received date must be 0..N days after the collection date. Default 14.
RECEIVED_AFTER_COLLECTION_MAX_DAYS=
# Evaluation only: skip the age-from-today check (sample forms are months old). Never true in production.
EVAL_MODE=

# Development only: cache model responses on disk. Never true in production.
# Contains personal data - clear with: .venv/Scripts/python -m src.clear_cache
DEV_CACHE=false

# Local database (src/record_store.py). It holds patient data on disk: not encrypted, never deleted automatically.
DB_ENABLED=true
# false: store no images (field crops / page previews); saved forms then open without images.
DB_STORE_CROPS=true
